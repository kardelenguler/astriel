# ---------- Uygulama ----------
APP_NAME=Astriel
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------- Veritabanı ----------
# Biçim: postgresql+psycopg://KULLANICI:SIFRE@SUNUCU:PORT/VERITABANI
DATABASE_URL=postgresql+psycopg://postgres:sifre@localhost:5432/astriel


# ---------- Güvenlik ----------
# En az 32 karakter olmalı; aşağıdaki değer bilerek geçersizdir (uygulama başlamaz).
# Kendi anahtarını üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=degistir-beni
ACCESS_TOKEN_EXPIRE_MINUTES=60 


# ---------- Frontend ----------
# Angular'ın çalıştığı adres (virgülle birden fazla yazılabilir)
CORS_ORIGINS=http://localhost:4200

# ---------- Yer arama (Nominatim) ----------
# Nominatim uygulamayı tanıyan bir User-Agent ister; kendi e-posta adresini yaz.
# Kurallara uymayan uygulamaların IP adresi engellenir.
GEOCODER_USER_AGENT=Astriel/0.1 (ornek@mail.com) 

# ---------- Astroloji ----------
EPHE_PATH=./ephemeris 

# ---------- Test ----------
# Testler bu veritabanını kullanır; adı mutlaka _test ile bitmeli
TEST_DATABASE_URL=postgresql+psycopg://postgres:sifre@localhost:5432/astriel_test 